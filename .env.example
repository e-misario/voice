# =============================================================================
# E-MIS@RIO SAS — Variables de Entorno (.env.example)
# =============================================================================

# Entorno general
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=change-this-to-a-super-secret-jwt-key-min-32-chars-emisario
ENCRYPTION_KEY=change-this-to-a-32-byte-fernet-key-for-integrations=

# Base de datos PostgreSQL
POSTGRES_USER=emisario_admin
POSTGRES_PASSWORD=emisario_secure_password_2026
POSTGRES_DB=emisario_voice_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://emisario_admin:emisario_secure_password_2026@postgres:5432/emisario_voice_db

# Redis (Cache, Sessions y Tareas)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# VoiceStudio Microservicio
VOICESTUDIO_HOST=voicestudio
VOICESTUDIO_PORT=8880
VOICESTUDIO_API_URL=http://voicestudio:8880

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=eyJh..._emisario_tunnel_token
PUBLIC_DOMAIN=voice.e-misario.com

# Integraciones de IA Globales / Fallback
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...

# Moneda y Precios Base
BASE_CURRENCY=USD
DEFAULT_MARGIN_PCT=15.0

# Servidor Remoto SSH (Despliegue)
REMOTE_SSH_USER=server
REMOTE_SSH_HOST=192.168.2.25
REMOTE_SSH_PORT=2210
REMOTE_TARGET_DIR=~/voice
